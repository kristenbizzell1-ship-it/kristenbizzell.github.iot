    .cta {
      text-align: center;
      padding: 60px 20px;
      background: #fde6f2;
    }
    .cta h2 {
      margin-bottom: 10px;
    }
    .cta p {
      font-size: 18px;
    }
    footer {
      background: #f3cbe3;
      text-align: center;
      padding: 30px 20px;
      font-size: 14px;
    }
    .btn {
      display: inline-block;
      margin-top: 20px;
      padding: 12px 24px;
      background: #cc5fa8;
      color: white;
      border-radius: 25px;
      text-decoration: none;
      font-weight: bold;
